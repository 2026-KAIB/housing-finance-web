# 브라우저는 기본적으로 같은 출처의 /api 경로를 사용한다.
# 백엔드를 브라우저에 직접 공개해야 할 때만 NEXT_PUBLIC_API_BASE_URL을 설정한다.
NEXT_PUBLIC_API_BASE_URL=

# 카카오맵 JavaScript 앱 키. 비어 있으면 지도 자리에 안내를 표시한다.
# 실제 키는 커밋되지 않는 .env 에만 넣는다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Next.js 서버가 Docker 내부에서 FastAPI에 접속하는 주소다.
# 로컬 개발에서는 localhost, 홈서버에서는 백엔드 컨테이너 이름을 사용한다.
BACKEND_API_URL=http://127.0.0.1:8000
